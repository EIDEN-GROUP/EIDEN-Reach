{
  "name": "eiden-reach",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "dev-worker": "cd workers/mailbox && npx wrangler dev --port 8787",
    "dev-all": "scripts\\dev-all.cmd",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --pretty",
